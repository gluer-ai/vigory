# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# LLM (litellm-backed; only the selected provider's key is required)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS. "*" for local dev; restrict to
# your deployed frontend origin(s) in production, e.g.
# CORS_ALLOWED_ORIGINS=https://vigory-frontend.up.railway.app
CORS_ALLOWED_ORIGINS=*

# Trafikverket Open API (Sweden traffic incidents/cameras feed).
# Get a free key at https://api.trafikinfo.trafikverket.se (or via Trafiklab).
TRAFIKVERKET_API_KEY=
FEEDS_ENABLED=true

# OpenSky Network (aircraft states, https://opensky-network.org/apidoc/).
# Works anonymously with no keys; optional OAuth2 client credentials raise
# the rate limit. Get one at https://opensky-network.org/my-opensky/account.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# "latmin,latmax,lonmin,lonmax"; empty = Sweden bbox.
OPENSKY_BBOX=

# aisstream.io (vessel AIS positions over WebSocket). Free key required:
# https://aisstream.io/authenticate
AISSTREAM_API_KEY=
AISSTREAM_BBOX=
AISSTREAM_LISTEN_SECONDS=8

# GDELT DOC 2.0 API (news articles). Free, keyless.
GDELT_QUERY="military OR conflict OR security"
GDELT_MAXRECORDS=50

# Frontend
VITE_API_BASE_URL=http://localhost:8000
