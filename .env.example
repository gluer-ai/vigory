# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# LLM (litellm-backed; only the selected provider's key is required)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS. "*" for local dev; restrict to
# your deployed frontend origin(s) in production, e.g.
# CORS_ALLOWED_ORIGINS=https://vigory-frontend.up.railway.app
CORS_ALLOWED_ORIGINS=*

# Knowledge base document uploads (PDF/DOCX/XLSX/TXT/MD).
# UPLOAD_DIR is relative to the backend process's working directory by
# default. In production (Railway), mount a persistent volume at this path
# — Railway's filesystem is otherwise ephemeral and uploaded files will be
# lost on the next deploy.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
INGEST_CHUNK_CHARS=8000

# Trafikverket Open API (Sweden traffic incidents/cameras feed).
# Get a free key at https://api.trafikinfo.trafikverket.se (or via Trafiklab).
TRAFIKVERKET_API_KEY=
FEEDS_ENABLED=true

# OpenSky Network (aircraft states, https://opensky-network.org/apidoc/).
# Works anonymously with no keys; optional OAuth2 client credentials raise
# the rate limit. Get one at https://opensky-network.org/my-opensky/account.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# "latmin,latmax,lonmin,lonmax"; empty = Sweden bbox.
OPENSKY_BBOX=

# aisstream.io (vessel AIS positions over WebSocket). Free key required:
# https://aisstream.io/authenticate
AISSTREAM_API_KEY=
AISSTREAM_BBOX=
AISSTREAM_LISTEN_SECONDS=8

# GDELT DOC 2.0 API (news articles). Free, keyless.
GDELT_QUERY="military OR conflict OR security"
GDELT_MAXRECORDS=50

# Caltrans CCTV (California traffic cameras, https://cwwp2.dot.ca.gov). Free,
# keyless. Comma-separated district numbers (1-12); default covers the four
# busiest metros (SF Bay, LA, San Diego, Sacramento).
CALTRANS_DISTRICTS=4,7,11,3

# TfL JamCams (London traffic cameras, https://api.tfl.gov.uk). Free,
# keyless; an optional app key only raises the list-endpoint rate limit.
# Get one at https://api-portal.tfl.gov.uk.
TFL_APP_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
